# Environment & secrets  -- NEVER commit these
.env
.env.local
.env.*.local
*.key
*.pem
esp32-firmware/**/secrets.h

# Database & runtime data
storage/*.db
storage/*.db-journal
storage/*.db-wal
storage/*.db-shm
storage/uploads/*
!storage/uploads/.gitkeep
storage/backups/*
!storage/backups/.gitkeep

# Node
node_modules/
npm-debug.log*
.npm

# Editors / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Arduino build output
esp32-firmware/**/build/
*.elf
*.bin.gz
