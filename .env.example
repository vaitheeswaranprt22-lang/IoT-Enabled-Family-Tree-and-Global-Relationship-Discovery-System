# =============================================================================
#  GLOBAL FAMILY TREE & ANCESTRY MAPPING SYSTEM  --  environment template
# =============================================================================
#  Copy this file to `.env` and fill in real values.  `.env` is git-ignored.
#      cp .env.example .env        (macOS / Linux)
#      copy .env.example .env      (Windows cmd)
#  NEVER commit `.env`, API keys, Wi-Fi passwords or database credentials.
# =============================================================================

# ---------- Server ----------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Public origin used in password-reset links and CORS checks.
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated list of allowed browser origins. "*" only for local demos.
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# ---------- Database ----------
# Path is relative to the repository root.
DATABASE_FILE=storage/familytree.db

# ---------- Security ----------
# REQUIRED IN PRODUCTION. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Used to sign session tokens, reset tokens and biometric challenge codes.
APP_SECRET=
# Session lifetime in minutes (password login).
SESSION_TTL_MINUTES=720
# Session lifetime in minutes for a biometric (kiosk) login -- keep it short.
BIOMETRIC_SESSION_TTL_MINUTES=60
# Password reset link lifetime in minutes.
RESET_TTL_MINUTES=30
# scrypt work factor. 16384 is the interactive default; raise for production.
SCRYPT_COST=16384
# Set to true behind a TLS-terminating proxy so cookies get the Secure flag.
TRUST_PROXY=false
FORCE_SECURE_COOKIES=false

# ---------- Rate limiting (requests per window per IP) ----------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_GENERAL=300
RATE_LIMIT_AUTH=10
RATE_LIMIT_DEVICE=60

# ---------- Biometric / IoT gateway ----------
# Seconds a browser-initiated biometric challenge stays valid.
BIOMETRIC_CHALLENGE_TTL_SECONDS=90
# Max clock skew (seconds) tolerated on a signed ESP32 request (replay window).
DEVICE_CLOCK_SKEW_SECONDS=120
# Lock a fingerprint slot after this many consecutive failures (0 = disabled).
BIOMETRIC_MAX_FAILURES=5
# Minimum confidence score the fingerprint sensor must report (R307/AS608: 0-200+).
BIOMETRIC_MIN_CONFIDENCE=50
# Allows the built-in browser "Virtual ESP32" simulator to act as a device.
# MUST be false in production -- it bypasses physical hardware possession.
DEMO_ALLOW_SIMULATED_DEVICE=true

# ---------- Relationship engine ----------
# Maximum number of edges a relationship path may traverse.
MAX_PATH_DEPTH=14
# Maximum distinct paths returned by "How am I related?".
MAX_PATHS_RETURNED=5
# Node budget for a single traversal (protects against very large graphs).
TRAVERSAL_NODE_BUDGET=60000

# ---------- Matching engine ----------
# Below this score a candidate is discarded entirely.
MATCH_MIN_SCORE=0.55
# At/above this score the candidate is flagged "strong" -- it is STILL only a
# Possible Match and STILL requires human verification. Nothing auto-merges.
MATCH_STRONG_SCORE=0.88
# Years of tolerance when comparing two dates of birth.
MATCH_DOB_TOLERANCE_YEARS=2

# ---------- AI-assisted suggestion layer ----------
# false  -> deterministic local heuristics only (no network calls, works offline)
# true   -> additionally consult the Claude API for ranking + written rationale
AI_ENABLED=false
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_CANDIDATES=25
AI_TIMEOUT_MS=20000

# ---------- Email (password reset) ----------
# "console" writes the reset link to the server log -- correct for a local demo.
# "smtp" requires the SMTP_* values below.
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@familytree.local

# ---------- Uploads ----------
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_BYTES=3145728

# ---------- Logging ----------
LOG_LEVEL=info
AUDIT_RETENTION_DAYS=365
